{
  "name": "polsia-app-template",
  "version": "0.3.7",
  "private": true,
  "description": "Polsia Next.js template with the shadcn UI baseline built in",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "dev": "next dev",
    "build": "NODE_OPTIONS=--max-old-space-size=4096 next build --webpack",
    "start": "next start",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration:signup-workspace": "node --env-file=.env --env-file=.env.test --conditions=react-server --import tsx tests/integration/signup-workspace.test.ts",
    "test:e2e": "PLAYWRIGHT_BROWSERS_PATH=./node_modules/.cache/ms-playwright node --env-file=.env --env-file=.env.test ./node_modules/@playwright/test/cli.js test",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-config-service": "3.1091.0",
    "@aws-sdk/client-dynamodb": "^3.1091.0",
    "@aws-sdk/client-ec2": "3.1091.0",
    "@aws-sdk/client-iam": "3.1091.0",
    "@aws-sdk/client-organizations": "3.1091.0",
    "@aws-sdk/client-rds": "^3.1091.0",
    "@aws-sdk/client-resource-explorer-2": "3.1091.0",
    "@aws-sdk/client-s3": "3.1091.0",
    "@aws-sdk/client-sts": "3.1091.0",
    "@azure/arm-authorization": "9.0.0",
    "@azure/arm-compute": "24.1.0",
    "@azure/arm-network": "^37.0.0",
    "@azure/arm-resources": "8.0.0",
    "@azure/arm-sql": "^9.0.0",
    "@azure/arm-storage": "20.1.0",
    "@azure/identity": "4.13.1",
    "@expo-google-fonts/noto-sans": "0.4.2",
    "@expo-google-fonts/noto-sans-jp": "0.4.3",
    "@google-cloud/compute": "6.13.0",
    "@google-cloud/iam-credentials": "4.2.2",
    "@google-cloud/resource-manager": "6.3.0",
    "@google-cloud/sql": "^0.25.0",
    "@google-cloud/storage": "7.21.0",
    "@hookform/resolvers": "5.4.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-accordion": "1.2.12",
    "@radix-ui/react-avatar": "1.1.11",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-collapsible": "1.1.12",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-dropdown-menu": "2.1.16",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-popover": "1.1.15",
    "@radix-ui/react-progress": "1.1.8",
    "@radix-ui/react-radio-group": "1.3.8",
    "@radix-ui/react-select": "2.2.6",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slider": "1.3.6",
    "@radix-ui/react-slot": "1.2.0",
    "@radix-ui/react-switch": "1.2.6",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.8",
    "@t3-oss/env-nextjs": "0.13.11",
    "better-auth": "1.7.23",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "16.6.1",
    "google-auth-library": "10.9.0",
    "lucide-react": "0.500.0",
    "next": "16.2.6",
    "next-themes": "0.4.6",
    "pdf-lib": "1.17.1",
    "posthog-js": "1.447.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "7.77.0",
    "server-only": "^0.0.1",
    "sonner": "2.0.7",
    "tailwind-merge": "2.6.0",
    "tsx": "4.20.6",
    "tw-animate-css": "1.4.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "22.13.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "4.4.0",
    "jsdom": "26.0.0",
    "prisma": "6.19.3",
    "tailwindcss": "4.3.0",
    "typescript": "5.5.4",
    "vitest": "3.2.6"
  },
  "overrides": {
    "postcss": "^8.5.10",
    "esbuild": "^0.28.1"
  }
}
